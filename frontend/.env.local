# Copy this file to .env.local and keep the backend running at this URL.
#
# NEXT_PUBLIC_ prefix means this value is readable from the browser (used
# by SearchBar/FilterBar client components, which call the API directly).
# Without the prefix, a var is server-only -- the home page's data fetch
# uses this same one from the server, so one value covers both.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Needed for Supabase Auth (login page), separate from the backend's own
# Supabase connection. Same project -- copy these from the Supabase
# dashboard: Settings -> API. The anon key here is the same Publishable
# key already used for SUPABASE_PUBLISHABLE_KEY in backend/.env.
NEXT_PUBLIC_SUPABASE_URL=https://bijbgfxfeyywmhrtgbnl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_l16ujwgKK_5S-N0njQUxig_IQsU9K78
NEXT_PUBLIC_GA_ID = G-NDQBW95EYT